{
  "name": "test-framework-scaffolder",
  "version": "1.3.3",
  "description": "One-stop Playwright automation and k6 performance testing framework scaffolder",
  "homepage": "https://github.com/Santhoshkarmegham/NPM-Scaffolds-pacakge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Santhoshkarmegham/NPM-Scaffolds-pacakge.git"
  },
  "bugs": {
    "url": "https://github.com/Santhoshkarmegham/NPM-Scaffolds-pacakge/issues"
  },
  "type": "module",
  "bin": {
    "test-framework-scaffolder": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "prepack": "npm run build && npm test"
  },
  "keywords": [
    "playwright",
    "typescript",
    "javascript",
    "python",
    "java",
    "k6",
    "performance-testing",
    "grafana",
    "testing",
    "bdd",
    "framework",
    "scaffolder",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.8.4",
    "chalk": "^5.6.2",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.18.3",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
