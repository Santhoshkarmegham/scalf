{
  "name": "test",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node scripts/run-tests.mjs",
    "test:smoke": "cross-env TEST_ENV=smoke npm test",
    "test:uat": "cross-env TEST_ENV=uat npm test",
    "test:ui": "cross-env TEST_SCOPE=ui npm test",
    "test:api": "cross-env TEST_SCOPE=api npm test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "clean": "node scripts/clean.mjs",
    "bddgen": "bddgen",
    "allure": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "allure generate allure-results --clean --single-file -o reports && node scripts/rename-allure-report.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.18.3",
    "cross-env": "^7.0.3",
    "dotenv": "^17.2.2",
    "eslint": "^10.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.0",
    "playwright-bdd": "^9.2.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.1"
  }
}
